# --- Voice (ElevenLabs) — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# run: node kit/cli.js voices   → copy a voice_id here
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Background plates (pick one; leave both empty to use free code-drawn backgrounds)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
FAL_KEY=
FAL_MODEL=fal-ai/flux/dev
# IMAGE_PROVIDER=openai   # or fal

# --- Optional: use your own Chrome instead of the one Puppeteer downloads
# CHROME_PATH=
